# --- Runtime ---
# Telegram bot token from @BotFather (required to actually run the bot).
BOT_TOKEN=123456:REPLACE_WITH_YOUR_BOTFATHER_TOKEN

# Where the SQLite database file lives.
# On Railway attach a volume to the service and point DB_PATH inside it, e.g.
#   DB_PATH=/data/game.db
# If DB_PATH is left unset the app auto-detects RAILWAY_VOLUME_MOUNT_PATH and
# uses <mount>/game.db, so attaching a volume is enough. Locally it falls back
# to ./data/game.db.
DB_PATH=data/game.db

# Comma separated Telegram user ids that get privileged commands (e.g. /admin).
ADMIN_IDS=5765828495

# --- Debug ---
# Log verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Skip the real Telegram network during smoke tests.
DRY_RUN=false

# --- Mini App ---
# Optional Telegram Mini App customizer URL (e.g. https://your-domain.railway.app/customizer)
WEBAPP_URL=
