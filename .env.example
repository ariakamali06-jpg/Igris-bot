# --- Runtime ---
# Telegram bot token from @BotFather (required to actually run the bot).
BOT_TOKEN=123456789:REPLACE_WITH_TOKEN_FROM_BOTFATHER

# Where the SQLite database file lives.
DB_PATH=data/game.db

# Comma separated Telegram user ids that get privileged commands (e.g. /admin).
# This list is the ONLY source of admin access (there is no hardcoded owner):
# replace the placeholder with YOUR Telegram user id to get full admin access.
ADMIN_IDS=123456789

# --- Debug ---
# Log verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Skip the real Telegram network during smoke tests.
DRY_RUN=false

# --- Mini App ---
# Optional Telegram Mini App customizer URL (e.g. https://your-domain.railway.app/customizer)
WEBAPP_URL=
